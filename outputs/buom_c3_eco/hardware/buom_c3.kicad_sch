345.44 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "737a6626-0916-530f-8c6f-f9ce591beeff")) (symbol (lib_id "Buom:PWR_FLAG") (at 90.17 345.44 0) (unit 1) (in_bom no) (on_board no) (dnp no) (uuid "e6f21135-8f5b-553d-aa17-3b13d7932470") (property "Reference" "#FLG003" (at 90.17 340.44 0) (effects (font (size 1.0 1.0)) hide)) (property "Value" "PWR_FLAG" (at 90.17 340.44 0) (effects (font (size 1.0 1.0)))) (instances (project "buom_c3" (path "/ae3c146d-b298-5c96-aab0-0cff7d35324c" (reference "#FLG003") (unit 1))))) (label "+5V" (at 90.17 345.44 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "eec147d4-cc4c-5b48-946e-5690976eb24b")) (symbol (lib_id "Buom:PWR_FLAG") (at 119.38 345.44 0) (unit 1) (in_bom no) (on_board no) (dnp no) (uuid "73431084-2429-5581-883d-8953b4f40399") (property "Reference" "#FLG004" (at 119.38 340.44 0) (effects (font (size 1.0 1.0)) hide)) (property "Value" "PWR_FLAG" (at 119.38 340.44 0) (effects (font (size 1.0 1.0)))) (instances (project "buom_c3" (path "/ae3c146d-b298-5c96-aab0-0cff7d35324c" (reference "#FLG004") (unit 1))))) (label "XIAO_5V" (at 119.38 345.44 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "0c79d026-92ff-539a-9946-c24df40f910b")) (text "BUOM C3 / REV A / 2S HV SERVO CARRIER" (at 20 12 0) (effects (font (size 2 2)) (justify left top)) (uuid "5b61ccfb-bfb0-5b88-9c19-411b5dd9b593")) (text "Prototype: electrical CAD verified; flight and thermal performance unmeasured." (at 20 18 0) (effects (font (size 1.3 1.3)) (justify left top)) (uuid "8e88b818-1fd8-5d60-a85b-8e0909e76243")) (text "U1 BAT pads NC. NEVER connect 2S to XIAO BAT or 5V.\nJ2: external regulated 5V >= 1A; common GND.\nD1 prevents USB feeding the external 5V bus.\nJ4: receiver TX -> MCU RX. Receiver RX unconnected." (at 160 345 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "5c973b04-7ebf-53b4-943b-449bd7916ae0")) (text "Q1 source pins 1/2/3 -> VBAT; drains 5/6/7/8 -> VSERVO.\nGate pulled to source by R3: servo power OFF at reset.\nPWM is forced LOW before switching servo rail OFF.\nUse keyed battery cable; no reverse-polarity protection." (at 370 345 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "e9865818-d325-548b-8d46-7c3d5d80232a")) (text "J7: 40 parallel LED branches, EACH with its own 2k2 resistor.\nWhite LED: +5V -> 2k2 -> anode; cathode -> LED_RETURN.\nIMU at CG: X forward, Y left, Z up; leads <= 50mm.\nDigital signal levels are 3.3V except buffered servo PWM." (at 160 370 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "f119c829-530f-5942-b93f-6dbf065a2331")) (text "Do not fit a 1S-only servo or SG90/MG90S.\nBench checks: polarity, 5V regulation, 3V3, ADC scale,\nservo pulse range, idle-off rail, current peaks, RF failsafe." (at 370 370 0) (effects (font (size 1.4 1.4)) (justify left top)) (uuid "2aed0a96-139c-58fd-bf4c-b6daf00dbbdb")) (embedded_fonts no))